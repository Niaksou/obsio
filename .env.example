# Copier ce fichier en .env et adapter les valeurs.
# Les valeurs ci-dessous ne conviennent qu'au développement local.

NODE_ENV=development

# --- PostgreSQL (docker compose)
POSTGRES_PORT=5433
POSTGRES_PASSWORD=postgres-local
APP_OWNER_PASSWORD=owner-local
APP_USER_PASSWORD=user-local
# Connexion de l'application (rôle soumis à la RLS)
DATABASE_URL=postgres://app_user:user-local@localhost:5433/obsio
# Connexion pour les migrations (propriétaire des tables)
DATABASE_OWNER_URL=postgres://app_owner:owner-local@localhost:5433/obsio
# Base dédiée aux tests automatisés
TEST_DATABASE_URL=postgres://app_user:user-local@localhost:5433/obsio_test
TEST_DATABASE_OWNER_URL=postgres://app_owner:owner-local@localhost:5433/obsio_test

# --- Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# --- Stockage objet S3 (RustFS en local, console sur http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=fr-par
S3_BUCKET=obsio-local
S3_ACCESS_KEY=obsio-local-access
S3_SECRET_KEY=obsio-local-secret-change-me
S3_FORCE_PATH_STYLE=true

# --- E-mail (Mailpit en local, interface sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Obsio <no-reply@localhost>"

# --- API et authentification
API_PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
# Expéditeur des invitations envoyées par « pnpm org:create » (compte technique, sans connexion)
OPERATOR_EMAIL=operateur@localhost.test
OPERATOR_NAME=L'équipe Obsio
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres

# --- Front (exposé au navigateur : rien de secret ici)
VITE_API_URL=http://localhost:3000

# --- Extraction (worker) : clé sur https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-1
MISTRAL_EXTRACTION_MODEL=mistral-medium-2604
