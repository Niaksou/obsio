{
  "name": "@obsio/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@obsio/source --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:check": "tsx --conditions=@obsio/source eval/check-fixtures.ts",
    "eval:extraction": "tsx --conditions=@obsio/source --env-file-if-exists=../../.env eval/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@mistralai/mistralai": "^3.2.0",
    "@obsio/shared": "workspace:*",
    "bullmq": "^6.4.1",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
