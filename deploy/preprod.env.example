# Copier en deploy/preprod.env (hors dépôt). Aucun secret ici : ils sont dans SECRETS_DIR, un
# fichier par secret, créés par : deploy/secrets.sh generer deploy/secrets
SECRETS_DIR=./secrets

# Adresse publique de l'application (front et API sous /api)
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Stockage S3 : RustFS du compose, ou l'offre de l'hébergeur (endpoint public)
S3_ENDPOINT=http://storage.localhost:9100
STORAGE_PORT=9100
S3_REGION=fr-par
S3_BUCKET=obsio-preprod

# E-mail : Mailpit du compose (interface sur le port MAILPIT_PORT), ou un vrai SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
# Mot de passe SMTP dans SECRETS_DIR/smtp_password
SMTP_USER=
MAILPIT_PORT=8125
MAIL_FROM="Obsio <no-reply@obsio.test>"
OPERATOR_EMAIL=operateur@obsio.test
OPERATOR_NAME=L'équipe Obsio
# Sans clé Mistral (SECRETS_DIR/mistral_api_key), les imports de rapports finissent en erreur.
