# Copier en deploy/preprod.env (hors dépôt) et remplacer toutes les valeurs « changer-moi ».
# Générer les secrets avec : openssl rand -base64 32

# Adresse publique de l'application (front et API sous /api)
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

POSTGRES_PASSWORD=changer-moi
APP_OWNER_PASSWORD=changer-moi
APP_USER_PASSWORD=changer-moi

# Stockage S3 : RustFS du compose, ou l'offre de l'hébergeur (endpoint public)
S3_ENDPOINT=http://storage.localhost:9100
STORAGE_PORT=9100
S3_REGION=fr-par
S3_BUCKET=obsio-preprod
S3_ACCESS_KEY=changer-moi
S3_SECRET_KEY=changer-moi

# E-mail : Mailpit du compose (interface sur le port MAILPIT_PORT), ou un vrai SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_PORT=8125
MAIL_FROM="Obsio <no-reply@obsio.test>"
OPERATOR_EMAIL=operateur@obsio.test
OPERATOR_NAME=L'équipe Obsio

BETTER_AUTH_SECRET=changer-moi
# Sans clé (ou sur l'offre gratuite), les imports de rapports finissent en erreur.
MISTRAL_API_KEY=
