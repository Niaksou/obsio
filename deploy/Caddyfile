# Une seule origine publique : le front, et l'API sous /api (cookies de session sans CORS).
{
	admin off
	# Certificats fournis (autorité interne, deploy/secrets.sh), aucun certificat à obtenir.
	auto_https off
	# Sur le serveur, le proxy (deploy/server/Caddyfile) est devant : garder l'adresse du client
	# qu'il transmet, pour la limitation de débit de l'API.
	servers {
		trusted_proxies static private_ranges
	}
}

(app) {
	encode zstd gzip

	# HTTPS jusqu'à l'API, certificat vérifié par l'autorité interne (ASVS 12.3.3).
	handle /api/* {
		reverse_proxy https://api:3000 {
			transport http {
				tls_trust_pool file /run/secrets/tls_ca
			}
		}
	}

	handle {
		root * /srv
		# Fichiers à empreinte : mis en cache longtemps ; le reste est revalidé à chaque visite.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fresh path /sw.js /index.html /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Le navigateur ne charge que depuis l'application et le stockage (photos, plans, envois).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$STORAGE_ORIGIN}; media-src 'self' blob: {$STORAGE_ORIGIN}; connect-src 'self' {$STORAGE_ORIGIN}; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), geolocation=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		-Server
	}
}

# Proxy du serveur (deploy/server/Caddyfile) : HTTPS avec le certificat interne du service.
https://:8443 {
	tls /run/secrets/tls_web_cert /run/secrets/tls_web_key
	import app
}

# Navigateur, sans proxy devant (préproduction sur une machine). Sur le serveur, ce port n'écoute
# que dans le conteneur (HTTP_BIND=127.0.0.1) : le proxy ne peut joindre que le port HTTPS.
http://:8080 {
	bind {$HTTP_BIND:0.0.0.0}
	import app
}
