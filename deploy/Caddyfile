# Une seule origine publique : le front, et l'API sous /api (cookies de session sans CORS).
{
	admin off
	# Sur le serveur, le proxy (deploy/server/Caddyfile) est devant : garder l'adresse du client
	# qu'il transmet, pour la limitation de débit de l'API.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Fichiers à empreinte : mis en cache longtemps ; le reste est revalidé à chaque visite.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fresh path /sw.js /index.html /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
