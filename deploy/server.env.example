# Copier en deploy/server.env (hors dépôt) et remplacer toutes les valeurs « changer-moi ».
# Aucun secret ici : ils sont chiffrés par SOPS sur le poste de l'éditeur et déposés dans
# SECRETS_DIR par deploy/secrets.sh envoyer (voir docs/deploiement.md).
SECRETS_DIR=/etc/obsio/secrets

# Adresses publiques (enregistrements DNS A vers l'IP du serveur)
APP_HOST=preprod.obsio.fr
STORAGE_HOST=stockage.preprod.obsio.fr
PUBLIC_URL=https://preprod.obsio.fr
# Adresse de contact pour Let's Encrypt (expiration des certificats)
ACME_EMAIL=changer-moi@obsio.fr

BACKUP_DIR=/var/backups/obsio

# Stockage S3 : RustFS, joint par son adresse publique
S3_ENDPOINT=https://stockage.preprod.obsio.fr
S3_REGION=fr-par
S3_BUCKET=obsio-preprod

# E-mail : SMTP de Brevo (Paramètres > SMTP & API), expéditeur sur un domaine validé chez Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Mot de passe SMTP dans le secret smtp_password
SMTP_USER=changer-moi
# Sans Brevo (test) : e-mails retenus dans Mailpit, consultable par tunnel SSH uniquement
# (voir docs/deploiement.md). Remplacer les trois lignes SMTP ci-dessus par :
#   COMPOSE_PROFILES=local,journaux
#   MAILPIT_PORT=127.0.0.1:8125
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
MAIL_FROM="Obsio <no-reply@obsio.fr>"
OPERATOR_EMAIL=changer-moi@obsio.fr
OPERATOR_NAME=L'équipe Obsio

# Journaux hors du serveur : source « Vector » chez Better Stack (région UE), voir
# docs/deploiement.md. Activer avec COMPOSE_PROFILES=journaux (ou local,journaux avec Mailpit).
# Jeton de la source dans le secret betterstack_token.
COMPOSE_PROFILES=journaux
BETTERSTACK_HOST=changer-moi.eu-nbg-2.betterstackdata.com

# Sans clé Mistral (secret mistral_api_key), les imports de rapports finissent en erreur.
