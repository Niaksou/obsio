# Copier en deploy/server.env (hors dépôt) et remplacer toutes les valeurs « changer-moi ».
# Générer les secrets avec : openssl rand -hex 32

# Adresses publiques (enregistrements DNS A vers l'IP du serveur)
APP_HOST=preprod.obsio.fr
STORAGE_HOST=stockage.preprod.obsio.fr
PUBLIC_URL=https://preprod.obsio.fr
# Adresse de contact pour Let's Encrypt (expiration des certificats)
ACME_EMAIL=changer-moi@obsio.fr

POSTGRES_PASSWORD=changer-moi
APP_OWNER_PASSWORD=changer-moi
APP_USER_PASSWORD=changer-moi
# Lettres et chiffres seulement (il figure dans une URL) : openssl rand -hex 32
REDIS_PASSWORD=changer-moi
BACKUP_DIR=/var/backups/obsio

# Stockage S3 : RustFS, joint par son adresse publique
S3_ENDPOINT=https://stockage.preprod.obsio.fr
S3_REGION=fr-par
S3_BUCKET=obsio-preprod
# Clés plus courtes (openssl rand -hex 16) : le stockage limite leur longueur
S3_ACCESS_KEY=changer-moi
S3_SECRET_KEY=changer-moi

# E-mail : SMTP de Brevo (Paramètres > SMTP & API), expéditeur sur un domaine validé chez Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=changer-moi
SMTP_PASSWORD=changer-moi
# Sans Brevo (test) : e-mails retenus dans Mailpit, consultable par tunnel SSH uniquement
# (voir docs/deploiement.md). Remplacer les quatre lignes SMTP ci-dessus par :
#   COMPOSE_PROFILES=local
#   MAILPIT_PORT=127.0.0.1:8125
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
MAIL_FROM="Obsio <no-reply@obsio.fr>"
OPERATOR_EMAIL=changer-moi@obsio.fr
OPERATOR_NAME=L'équipe Obsio

BETTER_AUTH_SECRET=changer-moi
# Sans clé, les imports de rapports finissent en erreur.
MISTRAL_API_KEY=
