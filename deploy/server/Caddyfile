# Proxy public du serveur : HTTPS automatique (Let's Encrypt) pour l'application et le stockage.
# Caddy transmet l'en-tête Host tel quel : les signatures S3 restent valides côté stockage.
{
	email {$ACME_EMAIL}
}

{$APP_HOST} {
	reverse_proxy web:8080
	header -Server
}

{$STORAGE_HOST} {
	reverse_proxy storage:9100
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}
