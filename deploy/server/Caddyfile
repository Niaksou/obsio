# Proxy public du serveur : HTTPS automatique (Let's Encrypt) pour l'application et le stockage.
# Caddy transmet l'en-tête Host tel quel : les signatures S3 restent valides côté stockage.
{
	email {$ACME_EMAIL}
}

# Vers l'application et le stockage : HTTPS, certificat vérifié par l'autorité interne
# (deploy/secrets.sh), jamais de repli en clair (ASVS 12.3.3).
(interne) {
	transport http {
		tls_trust_pool file /run/secrets/tls_ca
	}
}

{$APP_HOST} {
	reverse_proxy https://web:8443 {
		import interne
	}
	header -Server
}

# HTTP : la page est redirigée vers HTTPS, mais l'API refuse (ASVS 4.1.2) : un appel en clair
# a déjà fait passer ses données sans chiffrement, le rediriger masquerait l'erreur.
# Les défis Let's Encrypt sur le port 80 restent traités par Caddy avant ces règles.
http://{$APP_HOST} {
	@api path /api /api/*
	handle @api {
		respond "HTTPS obligatoire" 403
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# Le stockage ne sert que des fichiers inertes (images, PDF) : aucun script, aucune intégration
# dans un cadre, et pas de lecture depuis un autre site que l'application (même site : obsio.fr).
{$STORAGE_HOST} {
	reverse_proxy https://storage:9100 {
		import interne
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Resource-Policy same-site
		-Server
	}
}
