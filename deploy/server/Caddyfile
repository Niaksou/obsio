# Proxy public du serveur : HTTPS automatique (Let's Encrypt) pour l'application et le stockage.
# Caddy transmet l'en-tête Host tel quel : les signatures S3 restent valides côté stockage.
{
	email {$ACME_EMAIL}
}

{$APP_HOST} {
	reverse_proxy web:8080
	header -Server
}

# Le stockage ne sert que des fichiers inertes (images, PDF) : aucun script, aucune intégration
# dans un cadre, et pas de lecture depuis un autre site que l'application (même site : obsio.fr).
{$STORAGE_HOST} {
	reverse_proxy storage:9100
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Resource-Policy same-site
		-Server
	}
}
